<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-platform-deployments</artifactId>
        <version>2026.1003.133413</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The TOPOLOGY domain: environments (tiers), services (one row per service, not one per
         tier), and the links that say which service runs in which environment. A plain library jar
         — entities, persistence, control, mapper, dto — with NO web/JAX-RS, no HTTP client and no
         process shell-out. It stores rows and enforces rules; it decides nothing about containers.

         It knows nothing about deployments, and that direction is the partition: `deployments`
         depends on this module, never the reverse. A service is identified by its NAME — the same
         name that is its image path segment, its network alias and part of every container name —
         and no column here holds another context's key.

         IT ALSO OWNS THE PERSISTENCE CONFIGURATION AND THE SCHEMA for the whole component, and
         that is deliberate rather than an accident of layering. The component is ONE database
         (`platformdeployments`) with ONE Flyway lineage, so both have to be declared exactly once:
         two library jars each shipping a META-INF/microprofile-config.properties at ordinal 100
         with the same datasource key would make the winner arbitrary. This module is the one both
         others depend on, so it is where "once" can live. The persistence unit therefore lists the
         entity packages of BOTH domains — see src/main/resources/META-INF/microprofile-config.properties.

         The directory is `environments/` and the artifactId is
         `qits-platform-deployments-environments`. -->
    <artifactId>qits-platform-deployments-environments</artifactId>
    <name>qits-platform-deployments :: environments</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean availability for consumers (no REST needed). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The component's store. It was a file H2 until the resource mechanism landed; this
                 component is now adopter #1 of its own `resources:` contract and runs on the
                 platform's postgres, provisioned by the bootstrap before it first boots. The
                 driver is also what the resource provisioner speaks plain JDBC through — one
                 pgjdbc on the classpath, no second datasource. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- PatientPgDriver, which this component's datasource opens every connection
                 through. It sits here because this module ships the config line that names the
                 driver, and the class and the line must not be able to drift apart. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of the core: without this module Flyway
                 refuses a postgres url with "no database found to handle". It sits here because
                 this module owns the lineage. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The causation persistence trio ONLY — CausedRow and CausationStamp on
                 PdEnvironment and PdService, @Uncaused on PdServiceLink. Three
                 jakarta-persistence-shaped types with no publish, no subscribe and no wire in
                 them; the bus itself stays in `service/`. This module has no @QuarkusTest, so the
                 jar's persistence unit never boots here and its suite owes it no database. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
