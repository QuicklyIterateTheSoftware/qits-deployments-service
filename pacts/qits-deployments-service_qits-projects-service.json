          }
        }
      },
      "description": "the deployment observation pass: getRepository",
      "key": "4283207b",
      "pending": false,
      "providerStates": [
        {
          "name": "a repository exists",
          "params": {
            "projectId": "00000000-0000-4000-8000-000000000001",
            "repoName": "contract-service",
            "repositoryId": "00000000-0000-4000-8000-000000000002"
          }
        }
      ],
      "request": {
        "generators": {
          "path": {
            "dataType": "RAW",
            "expression": "/projects/api/repositories/${repositoryId}",
            "type": "ProviderState"
          }
        },
        "method": "GET",
        "path": "/projects/api/repositories/00000000-0000-4000-8000-000000000002"
      },
      "response": {
        "body": {
          "content": {
            "repository": {
              "name": "contract-service"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.repository.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
