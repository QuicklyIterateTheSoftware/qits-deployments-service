          }
        }
      },
      "description": "the deployment observation pass: listProjectRepositories",
      "key": "90843cd",
      "pending": false,
      "providerStates": [
        {
          "name": "a project with one repository",
          "params": {
            "projectId": "00000000-0000-4000-8000-000000000001"
          }
        }
      ],
      "request": {
        "generators": {
          "path": {
            "dataType": "RAW",
            "expression": "/projects/api/projects/${projectId}/repositories",
            "type": "ProviderState"
          }
        },
        "method": "GET",
        "path": "/projects/api/projects/00000000-0000-4000-8000-000000000001/repositories"
